[
  {
    "name": "ECG_assess_quality",
    "description": "Assess ECG signal quality from a CSV waveform.",
    "modality": "ECG",
    "parameters": {
      "signal_path": {
        "type": "string",
        "description": "Path to a CSV file containing ECG samples."
      },
      "sampling_rate": {
        "type": "number",
        "description": "Sampling rate in Hz."
      },
      "column": {
        "type": [
          "string",
          "null"
        ],
        "description": "Optional CSV column name; defaults to signal or first numeric column."
      }
    },
    "returns": [
      "quality",
      "finite_ratio",
      "dynamic_range",
      "clipped_ratio",
      "confidence"
    ]
  },
